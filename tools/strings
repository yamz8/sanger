#!/usr/bin/env python3
"""Lists every translatable string in src/ as JSON: qsTr() in QML, tr() and
QCoreApplication::translate() in C++. Counted strings (with %n or %Ln) are
marked plural, so catalogs know to give them as plural forms.

With --check, instead says which catalogs in src/i18n miss a string, keep one
that is gone, or drop a placeholder, and exits 1 if any do."""
import json, pathlib, re, sys

root = pathlib.Path(__file__).resolve().parent.parent / "src"
literal = r'"((?:[^"\\]|\\.)*)"'
patterns = [re.compile(r'\bqsTr\(\s*' + literal), re.compile(r'(?<![\w:])tr\(\s*' + literal),
            re.compile(r'translate\(\s*"[A-Za-z]+",\s*' + literal)]


def strings():
    found = {}
    for path in sorted(root.glob("*")):
        # The translator's own comments show qsTr() examples that aren't strings.
        if path.suffix not in (".qml", ".cpp", ".h") or path.stem == "translator":
            continue
        text = path.read_text()
        for pattern in patterns:
            for match in pattern.finditer(text):
                source = json.loads('"' + match.group(1) + '"')
                found.setdefault(source, "%n" in source or "%Ln" in source)
    return found


def check(found):
    placeholders = re.compile(r"%[123]")
    problems = []
    for path in sorted((root / "i18n").glob("*.json")):
        catalog = json.loads(path.read_text())
        name = path.name
        if path.stem == "en":
            missing = [t for t, plural in found.items() if plural and t not in catalog]
        else:
            missing = [t for t in found if t not in catalog]
        problems += [f"{name}: missing {t!r}" for t in missing]
        problems += [f"{name}: {t!r} is no longer used" for t in catalog if t not in found]
        for key, value in catalog.items():
            forms = value if isinstance(value, dict) else {"": value}
            if found.get(key) and (not isinstance(value, dict) or "other" not in value):
                problems.append(f"{name}: {key!r} needs plural forms with 'other'")
            for form in forms.values():
                if sorted(placeholders.findall(form)) != sorted(placeholders.findall(key)):
                    problems.append(f"{name}: {key!r} -> {form!r} changes the placeholders")
    for problem in problems:
        print(problem, file=sys.stderr)
    return 1 if problems else 0


found = strings()
if sys.argv[1:] == ["--check"]:
    sys.exit(check(found))
json.dump([{"text": t, "plural": p} for t, p in found.items()], sys.stdout, ensure_ascii=False, indent=1)
print()
